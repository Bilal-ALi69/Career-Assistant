# Generate a unique value with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-32-byte-secret
# Optional: defaults to 86,400 seconds (24 hours).
# TOKEN_EXPIRY_SECONDS=86400
# Optional: comma-separated frontend origins for CORS, e.g. http://localhost:3000
# FRONTEND_ORIGINS=https://example.com,http://localhost:3000
# Optional: bcrypt work factor round count
# BCRYPT_ROUNDS=12
